{
  "name": "2048-deluxe",
  "version": "1.0.0",
  "description": "2048 Deluxe — Cyber & Retro Edition",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . \"2048 Deluxe\" --platform=win32 --arch=x64 --icon=assets/icon.ico --out=dist --overwrite --ignore=\"^/tests\" --ignore=\"^/dist\" --prune=true",
    "test": "node --test tests/test_engine_unit.js tests/test_ui_unit.js tests/test_juice_unit.js"
  },
  "keywords": [
    "2048",
    "game",
    "cyberpunk",
    "retro",
    "web-audio",
    "canvas",
    "electron"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-packager": "^17.1.2"
  }
}
